model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Country","Date","Owner","Priority","Priority Rule","Review Reason","CRM Contact Sync","CRM Update","Daily Backlog","Enquiry","Follow-up","Lead","Reconciliation Run","Review Case","KPI Summary"]

annotation PBI_ProTooling = ["DevMode"]

ref table Country
ref table Date
ref table Owner
ref table Priority
ref table 'Priority Rule'
ref table 'Review Reason'
ref table 'CRM Contact Sync'
ref table 'CRM Update'
ref table 'Daily Backlog'
ref table Enquiry
ref table Follow-up
ref table Lead
ref table 'Reconciliation Run'
ref table 'Review Case'
ref table 'KPI Summary'
ref table _Measures

ref role Salesperson
ref role 'Sales Manager and RevOps'

ref cultureInfo en-US

