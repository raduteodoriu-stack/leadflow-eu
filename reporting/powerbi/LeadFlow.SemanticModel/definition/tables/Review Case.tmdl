	/// Working time a case has been open (1 d = 9 working hours).
	column 'Open for' = VAR m = 'Review Case'[open_age_working_minutes] VAR d = INT ( m / 540 ) VAR h = INT ( MOD ( m, 540 ) / 60 ) RETURN IF ( ISBLANK ( m ), BLANK (), IF ( d > 0, d & " d ", "" ) & h & " h " & MOD ( m, 60 ) & " min" )
		dataType: string
		lineageTag: 810ae34a-b9ed-55cb-8652-54399c0acdf4
		summarizeBy: none
		sortByColumn: open_age_working_minutes

		annotation SummarizationSetBy = Automatic

