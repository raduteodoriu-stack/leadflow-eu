		sourceColumn: lead_ref

		annotation SummarizationSetBy = Automatic

	/// Working time a lead has waited for an owner (1 d = 9 working hours).
	column 'Waiting for' = VAR m = 'Lead'[waiting_working_minutes] VAR d = INT ( m / 540 ) VAR h = INT ( MOD ( m, 540 ) / 60 ) RETURN IF ( ISBLANK ( m ), BLANK (), IF ( d > 0, d & " d ", "" ) & h & " h " & MOD ( m, 60 ) & " min" )
		dataType: string
		lineageTag: be3ac102-d2d3-59ec-a156-c03fd7934989
		summarizeBy: none
		sortByColumn: waiting_working_minutes

		annotation SummarizationSetBy = Automatic

	/// Working time left until the SLA deadline (1 d = 9 working hours).
	column 'Time left' = VAR m = 'Lead'[working_minutes_to_deadline] VAR d = INT ( m / 540 ) VAR h = INT ( MOD ( m, 540 ) / 60 ) RETURN IF ( ISBLANK ( m ), BLANK (), IF ( d > 0, d & " d ", "" ) & h & " h " & MOD ( m, 60 ) & " min" )
		dataType: string
		lineageTag: d7f79056-8164-52ee-85a2-c599c536d542
		summarizeBy: none
		sortByColumn: working_minutes_to_deadline

		annotation SummarizationSetBy = Automatic

